{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "env": {
    "DEMO_READ_ONLY": "1"
  },
  "crons": [
    {
      "path": "/api/cron/run-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/check-websites",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/crawl-directories",
      "schedule": "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"
    },
    {
      "path": "/api/cron/lookup-directories",
      "schedule": "8,23,38,53 * * * *"
    }
  ]
}
