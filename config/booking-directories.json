{
  "description": "Booking platforms to look a business up on when their own website cannot answer the question. Answers the single most valuable fact about a prospect: are they already booking online? A business FOUND on one of these is a WORSE prospect \u2014 they have an incumbent \u2014 so a false positive here costs a good lead, and a false negative costs a wasted phone call.",
  "verificationNote": "PROVEN, from real runs: Booksy (https://booksy.com/en-us/s/{industry}/{cityId}_{city}) and Vagaro (https://www.vagaro.com/listings/{industry}/{city}--{state}). Both crawl cleanly and are requiredForNone \u2014 absence from both, plus nothing on the business's own website, is what licenses a 'no online booking' verdict. DISPROVEN, also from real runs, which is why the other three are off: Fresha returns HTTP 410 Gone on every URL shape tried, which is a deliberate block rather than a wrong guess; Square returns 404 on every shape, so its directory URL is simply unknown; StyleSeat returns 200 with no profile links in the HTML, meaning its results are drawn by script and no URL will ever expose them to a crawler. Do not re-enable any of these on a guess \u2014 nine candidate URLs have already been tried and logged. Getting them would need either a real browser or the paid search fallback, and neither is worth it while two platforms cover the question.",
  "matching": {
    "minimumNameSimilarity": 0.82,
    "requireCityMatch": true,
    "notes": "Both conditions must hold. Salon names repeat constantly across a state \u2014 there are dozens of 'Hair Studio' listings in Florida alone \u2014 so a name match without a city match is not evidence of anything."
  },
  "platforms": [
    {
      "id": "booksy",
      "label": "Booksy",
      "domain": "booksy.com",
      "searchUrlTemplate": "https://booksy.com/en-us/s/{query}",
      "profilePathPattern": "/en-us/[0-9]+_",
      "enabled": true,
      "listing": {
        "pageParam": "page",
        "firstPage": 1,
        "maxPages": 8,
        "cityIndex": {
          "urlTemplates": [
            "https://booksy.com/en-us/s/{industry}",
            "https://booksy.com/en-us/sitemap.xml",
            "https://booksy.com/sitemap.xml",
            "https://booksy.com/en-us/"
          ],
          "cityLinkPatterns": [
            "/en-us/s/[a-z0-9-]+/(\\d+)_([a-z0-9-]+)",
            "/en-us/\\d+_[a-z0-9-]+_[a-z0-9-]+_(\\d+)_([a-z0-9-]+)"
          ]
        },
        "urlTemplates": [
          "https://booksy.com/en-us/s/{industry}/{cityId}_{city}"
        ]
      },
      "requiredForNone": true
    },
    {
      "id": "vagaro",
      "label": "Vagaro",
      "domain": "vagaro.com",
      "searchUrlTemplate": "https://www.vagaro.com/search?q={query}",
      "profilePathPattern": "^/[a-z0-9-]+$",
      "enabled": true,
      "listing": {
        "pageParam": "page",
        "firstPage": 1,
        "maxPages": 8,
        "urlTemplates": [
          "https://www.vagaro.com/listings/{industry}/{city}--{state}",
          "https://www.vagaro.com/listings/{city}--{state}/{industry}"
        ]
      },
      "requiredForNone": true
    },
    {
      "id": "square",
      "label": "Square Appointments",
      "domain": "squareup.com",
      "searchUrlTemplate": "https://squareup.com/appointments/search?q={query}",
      "profilePathPattern": "/appointments/book/",
      "enabled": false,
      "listing": {
        "pageParam": null,
        "firstPage": 1,
        "maxPages": 3,
        "urlTemplates": [
          "https://squareup.com/appointments/search/{city}-{state}/{industry}",
          "https://squareup.com/appointments/book/{city}-{state}/{industry}",
          "https://squareup.com/us/en/appointments/{industry}/{city}-{state}"
        ]
      },
      "requiredForNone": false
    },
    {
