{
  "description": "Booking platforms to look a business up on when their own website cannot answer the question. Answers the single most valuable fact about a prospect: are they already booking online? A business FOUND on one of these is a WORSE prospect \u2014 they have an incumbent \u2014 so a false positive here costs a good lead, and a false negative costs a wasted phone call.",
  "verificationNote": "Booksy and Vagaro are PROVEN: both crawl cleanly against their live town directories, and their town-id and profile-URL patterns were confirmed by real runs. They are requiredForNone, meaning absence from both (plus nothing on the business's own website) is what licenses a 'no online booking' verdict. Square, StyleSeat and Fresha are crawled for what they can positively tell us \u2014 found there means they book online, which is a complete answer on its own \u2014 but are NOT requiredForNone, because their URL shapes are still candidates. An unproven platform must never be able to freeze every lead in the database by failing to answer. Promote one to requiredForNone once its crawls have been clean for a while. Each lead's evidence names the platforms actually searched, so the scope of a NONE never has to be taken on trust.",
  "matching": {
    "minimumNameSimilarity": 0.82,
    "requireCityMatch": true,
    "notes": "Both conditions must hold. Salon names repeat constantly across a state \u2014 there are dozens of 'Hair Studio' listings in Florida alone \u2014 so a name match without a city match is not evidence of anything."
  },
  "platforms": [
    {
      "id": "booksy",
      "label": "Booksy",
      "domain": "booksy.com",
      "searchUrlTemplate": "https://booksy.com/en-us/s/{query}",
      "profilePathPattern": "/en-us/[0-9]+_",
      "enabled": true,
      "listing": {
        "pageParam": "page",
        "firstPage": 1,
        "maxPages": 8,
        "cityIndex": {
          "urlTemplates": [
            "https://booksy.com/en-us/s/{industry}",
            "https://booksy.com/en-us/sitemap.xml",
            "https://booksy.com/sitemap.xml",
            "https://booksy.com/en-us/"
          ],
          "cityLinkPatterns": [
            "/en-us/s/[a-z0-9-]+/(\\d+)_([a-z0-9-]+)",
            "/en-us/\\d+_[a-z0-9-]+_[a-z0-9-]+_(\\d+)_([a-z0-9-]+)"
          ]
        },
        "urlTemplates": [
          "https://booksy.com/en-us/s/{industry}/{cityId}_{city}"
        ]
      },
      "requiredForNone": true
    },
    {
      "id": "vagaro",
      "label": "Vagaro",
      "domain": "vagaro.com",
      "searchUrlTemplate": "https://www.vagaro.com/search?q={query}",
      "profilePathPattern": "^/[a-z0-9-]+$",
      "enabled": true,
      "listing": {
        "pageParam": "page",
        "firstPage": 1,
        "maxPages": 8,
        "urlTemplates": [
          "https://www.vagaro.com/listings/{industry}/{city}--{state}",
          "https://www.vagaro.com/listings/{city}--{state}/{industry}"
        ]
      },
      "requiredForNone": true
    },
    {
      "id": "square",
      "label": "Square Appointments",
      "domain": "squareup.com",
      "searchUrlTemplate": "https://squareup.com/appointments/search?q={query}",
      "profilePathPattern": "/appointments/book/",
      "enabled": true,
      "listing": {
        "pageParam": null,
        "firstPage": 1,
        "maxPages": 3,
        "urlTemplates": [
          "https://squareup.com/appointments/search/{city}-{state}/{industry}",
          "https://squareup.com/appointments/book/{city}-{state}/{industry}",
          "https://squareup.com/us/en/appointments/{industry}/{city}-{state}"
        ]
      },
      "requiredForNone": false
    },
    {
      "id": "styleseat",
      "label": "StyleSeat",
      "domain": "styleseat.com",
      "searchUrlTemplate": "https://www.styleseat.com/m/search?q={query}",
      "profilePathPattern": "^/m/v/",
      "enabled": true,
      "listing": {
        "pageParam": "page",
        "firstPage": 1,
        "maxPages": 3,
        "urlTemplates": [
          "https://www.styleseat.com/m/search/{city}-{state}/{industry}",
          "https://www.styleseat.com/{industry}/{state}/{city}",
          "https://www.styleseat.com/m/l/{state}/{city}/{industry}"
        ]
      },
      "requiredForNone": false
    },
    {
      "id": "fresha",
      "label": "Fresha",
      "domain": "fresha.com",
      "searchUrlTemplate": "https://www.fresha.com/search?q={query}",
      "profilePathPattern": "^/a/",
      "enabled": true,
      "listing": {
        "pageParam": "page",
        "firstPage": 1,
        "maxPages": 3,
        "urlTemplates": [
          "https://www.fresha.com/a/{city}-{state}",
          "https://www.fresha.com/s/{industry}/{city}-{state}",
          "https://www.fresha.com/browse/{industry}/{city}-{state}"
        ]
      },
      "requiredForNone": false
    },
    {
      "id": "glossgenius",
      "label": "GlossGenius",
      "domain": "glossgenius.com",
      "searchUrlTemplate": "https://www.glossgenius.com/search?q={query}",
      "profilePathPattern": "^/[a-z0-9-]+$",
      "enabled": false
    }
  ]
}
