{
  "description": "Pipedrive hand-off mapping. Edit this file (not code) to change what gets synced. `customFieldKey` values are the 40-character hash keys Pipedrive assigns to custom fields — they only exist once the fields are created in a real Pipedrive account, so they are null until then. A null key means that field is previewed but skipped on a real push, never guessed.",
  "connection": {
    "apiBaseUrl": "https://api.pipedrive.com/v1",
    "companyDomain": null,
    "apiTokenEnvVar": "PIPEDRIVE_API_TOKEN",
    "liveSyncEnvVar": "PIPEDRIVE_LIVE_SYNC",
    "notes": "Live calls require BOTH the token env var to be set AND the live-sync env var to equal '1'. With either missing the adapter stays in dry-run and makes no network requests."
  },
  "organization": {
    "objectLabel": "Organization",
    "nameFrom": "businessName",
    "addressFrom": "address",
    "standardFields": [
      { "leadField": "businessName", "pipedriveField": "name", "required": true },
      { "leadField": "address", "pipedriveField": "address", "required": false }
    ],
    "customFields": [
      { "leadField": "prospectScore", "label": "Prospect Score", "type": "double", "customFieldKey": null },
      { "leadField": "qualificationStatus", "label": "Qualification Status", "type": "enum", "customFieldKey": null },
      { "leadField": "dataConfidence", "label": "Data Confidence", "type": "enum", "customFieldKey": null },
      { "leadField": "websiteStatus", "label": "Website Status", "type": "enum", "customFieldKey": null },
      { "leadField": "websiteQuality", "label": "Website Quality", "type": "enum", "customFieldKey": null },
      { "leadField": "onlineBookingStatus", "label": "Online Booking Status", "type": "enum", "customFieldKey": null },
      { "leadField": "bookingProvider", "label": "Booking Provider", "type": "varchar", "customFieldKey": null },
      { "leadField": "bookingMethod", "label": "Booking Method", "type": "enum", "customFieldKey": null },
      { "leadField": "staffCount", "label": "Staff Count", "type": "double", "customFieldKey": null },
      { "leadField": "rating", "label": "Google Rating", "type": "double", "customFieldKey": null },
      { "leadField": "reviewCount", "label": "Review Count", "type": "double", "customFieldKey": null },
      { "leadField": "industry", "label": "Industry", "type": "enum", "customFieldKey": null },
      { "leadField": "scoreReason", "label": "Score Reason", "type": "text", "customFieldKey": null },
      { "leadField": "discoverySource", "label": "Discovery Source", "type": "varchar", "customFieldKey": null }
    ]
  },
  "person": {
    "objectLabel": "Person",
    "createWhen": "phone-or-email-present",
    "nameTemplate": "{businessName} (main contact)",
    "standardFields": [
      { "leadField": "phone", "pipedriveField": "phone", "required": false },
      { "leadField": "email", "pipedriveField": "email", "required": false }
    ]
  },
  "deal": {
    "objectLabel": "Deal",
    "createWhen": "qualification-status-qualified-or-high-priority",
    "titleTemplate": "{businessName} — {industryLabel}",
    "pipelineId": null,
    "currency": "USD",
    "valueFrom": null,
    "valueNote": "No deal value is sent. This system does not model revenue and will not invent one.",
    "stageMap": {
      "RESEARCH": null,
      "QUALIFICATION": null,
      "CRM": null,
      "OUTREACH": null,
      "FOLLOW_UP": null,
      "SALE": null
    },
    "stageMapNote": "Map each internal pipeline stage to a numeric Pipedrive stage id once the pipeline exists. Unmapped stages are skipped rather than defaulting to stage 1."
  }
}
