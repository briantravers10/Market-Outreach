.env.local
# Working credentials live here and must never be committed. An earlier version
# of NEEDS_OWNER_INPUT.md carried real ones and put them in the git history.
SECRETS.local.md
*.local.md

__pycache__/
*.pyc

# Stray database files a local `next start` writes when it resolves a relative
# data path from a different working directory. They are a copy of data/demo.db
# and were committed once by a `git add -A`; 950KB of noise in the history.
/home/
*.db-wal
*.db-shm
