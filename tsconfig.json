{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@market-outreach/core": ["packages/core/src/index.ts"],
      "@market-outreach/db": ["packages/db/src/index.ts"]
    }
  },
  "include": ["scripts"]
}
